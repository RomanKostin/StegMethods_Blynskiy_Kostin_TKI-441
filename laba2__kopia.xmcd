											<ml:parens>
												<ml:apply>
													<ml:plus/>
													<ml:apply>
														<ml:mult/>
														<ml:id xml:space="preserve">Ne</ml:id>
														<ml:parens>
															<ml:apply>
																<ml:minus/>
																<ml:id xml:space="preserve">m</ml:id>
																<ml:real>1</ml:real>
															</ml:apply>
														</ml:parens>
													</ml:apply>
													<ml:real>1</ml:real>
												</ml:apply>
											</ml:parens>
											<ml:apply>
												<ml:mult/>
												<ml:id xml:space="preserve">Ne</ml:id>
												<ml:id xml:space="preserve">m</ml:id>
											</ml:apply>
											<ml:real>1</ml:real>
											<ml:real>1</ml:real>
										</ml:sequence>
									</ml:apply>
								</ml:localDefine>
								<ml:localDefine>
									<ml:id xml:space="preserve">ce</ml:id>
									<ml:apply>
										<ml:vectorize/>
										<ml:parens>
											<ml:apply>
												<ml:mult/>
												<ml:parens>
													<ml:apply>
														<ml:minus/>
														<ml:id xml:space="preserve">se</ml:id>
														<ml:id xml:space="preserve">c</ml:id>
													</ml:apply>
												</ml:parens>
												<ml:apply>
													<ml:id xml:space="preserve">CHIP</ml:id>
													<ml:id xml:space="preserve">m</ml:id>
												</ml:apply>
											</ml:apply>
										</ml:parens>
									</ml:apply>
								</ml:localDefine>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:apply>
											<ml:id xml:space="preserve">sign</ml:id>
											<ml:apply>
												<ml:id xml:space="preserve">mean</ml:id>
												<ml:id xml:space="preserve">c</ml:id>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:id xml:space="preserve">sign</ml:id>
											<ml:apply>
												<ml:id xml:space="preserve">mean</ml:id>
												<ml:id xml:space="preserve">ce</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:apply>
									<ml:localDefine>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">Mebin</ml:id>
											<ml:id xml:space="preserve">m</ml:id>
										</ml:apply>
										<ml:real>1</ml:real>
									</ml:localDefine>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:notEqual/>
										<ml:apply>
											<ml:id xml:space="preserve">sign</ml:id>
											<ml:apply>
												<ml:id xml:space="preserve">mean</ml:id>
												<ml:id xml:space="preserve">c</ml:id>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:id xml:space="preserve">sign</ml:id>
											<ml:apply>
												<ml:id xml:space="preserve">mean</ml:id>
												<ml:id xml:space="preserve">ce</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:apply>
									<ml:localDefine>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">Mebin</ml:id>
											<ml:id xml:space="preserve">m</ml:id>
										</ml:apply>
										<ml:real>0</ml:real>
									</ml:localDefine>
								</ml:ifThen>
								<ml:localDefine>
									<ml:id xml:space="preserve">m</ml:id>
									<ml:apply>
										<ml:plus/>
										<ml:id xml:space="preserve">m</ml:id>
										<ml:real>1</ml:real>
									</ml:apply>
								</ml:localDefine>
							</ml:program>
						</ml:while>
						<ml:for>
							<ml:id xml:space="preserve">j</ml:id>
							<ml:range>
								<ml:real>1</ml:real>
								<ml:apply>
									<ml:div inline="true"/>
									<ml:apply>
										<ml:id xml:space="preserve">rows</ml:id>
										<ml:id xml:space="preserve">Mebin</ml:id>
									</ml:apply>
									<ml:real>8</ml:real>
								</ml:apply>
							</ml:range>
							<ml:localDefine>
								<ml:apply>
									<ml:indexer/>
									<ml:id xml:space="preserve">Mevec</ml:id>
									<ml:id xml:space="preserve">j</ml:id>
								</ml:apply>
								<ml:apply>
									<ml:id xml:space="preserve">B2D</ml:id>
									<ml:apply>
										<ml:id xml:space="preserve">submatrix</ml:id>
										<ml:sequence>
											<ml:id xml:space="preserve">Mebin</ml:id>
											<ml:apply>
												<ml:minus/>
												<ml:apply>
													<ml:mult/>
													<ml:real>8</ml:real>
													<ml:id xml:space="preserve">j</ml:id>
												</ml:apply>
												<ml:real>7</ml:real>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:real>8</ml:real>
												<ml:id xml:space="preserve">j</ml:id>
											</ml:apply>
											<ml:real>1</ml:real>
											<ml:real>1</ml:real>
										</ml:sequence>
									</ml:apply>
								</ml:apply>
							</ml:localDefine>
						</ml:for>
						<ml:apply>
							<ml:id xml:space="preserve">vec2str</ml:id>
							<ml:id xml:space="preserve">Mevec</ml:id>
						</ml:apply>
