		<region region-id="523" left="252" top="1071" width="225.75" height="297" align-x="305.25" align-y="1080" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">CHIP</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">start</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:program>
						<ml:localDefine>
							<ml:id xml:space="preserve">μ</ml:id>
							<ml:id xml:space="preserve">μ10</ml:id>
						</ml:localDefine>
						<ml:for>
							<ml:id xml:space="preserve">i</ml:id>
							<ml:range>
								<ml:real>1</ml:real>
								<ml:id xml:space="preserve">N</ml:id>
							</ml:range>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:equal/>
										<ml:id xml:space="preserve">i</ml:id>
										<ml:real>1</ml:real>
									</ml:apply>
									<ml:program>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">Rdec</ml:id>
												<ml:id xml:space="preserve">i</ml:id>
											</ml:apply>
											<ml:id xml:space="preserve">start</ml:id>
										</ml:localDefine>
										<ml:localDefine>
											<ml:id xml:space="preserve">Rbin</ml:id>
											<ml:apply>
												<ml:id xml:space="preserve">D2B</ml:id>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">Rdec</ml:id>
													<ml:id xml:space="preserve">i</ml:id>
												</ml:apply>
											</ml:apply>
										</ml:localDefine>
									</ml:program>
								</ml:ifThen>
								<ml:ifThen>
									<ml:apply>
										<ml:greaterOrEqual/>
										<ml:id xml:space="preserve">i</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
									<ml:program>
										<ml:localDefine>
											<ml:id xml:space="preserve">bit</ml:id>
											<ml:real>0</ml:real>
										</ml:localDefine>
										<ml:for>
											<ml:id xml:space="preserve">j</ml:id>
											<ml:range>
												<ml:real>1</ml:real>
												<ml:id xml:space="preserve">d</ml:id>
											</ml:range>
											<ml:ifThen>
												<ml:apply>
													<ml:equal/>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">μ</ml:id>
														<ml:id xml:space="preserve">j</ml:id>
													</ml:apply>
													<ml:real>1</ml:real>
												</ml:apply>
												<ml:localDefine>
													<ml:id xml:space="preserve">bit</ml:id>
													<ml:apply>
														<ml:indexer/>
														<ml:id xml:space="preserve">Rbin</ml:id>
														<ml:id xml:space="preserve">j</ml:id>
													</ml:apply>
												</ml:localDefine>
											</ml:ifThen>
										</ml:for>
										<ml:localDefine>
											<ml:id xml:space="preserve">R</ml:id>
											<ml:id xml:space="preserve">Rbin</ml:id>
										</ml:localDefine>
										<ml:for>
											<ml:id xml:space="preserve">j</ml:id>
											<ml:range>
												<ml:real>1</ml:real>
												<ml:id xml:space="preserve">d</ml:id>
											</ml:range>
											<ml:program>
												<ml:ifThen>
													<ml:apply>
														<ml:greaterThan/>
														<ml:id xml:space="preserve">j</ml:id>
														<ml:real>1</ml:real>
													</ml:apply>
													<ml:localDefine>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">Rbin</ml:id>
															<ml:id xml:space="preserve">j</ml:id>
														</ml:apply>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">R</ml:id>
															<ml:apply>
																<ml:minus/>
																<ml:id xml:space="preserve">j</ml:id>
																<ml:real>1</ml:real>
															</ml:apply>
														</ml:apply>
													</ml:localDefine>
												</ml:ifThen>
												<ml:ifThen>
													<ml:apply>
														<ml:equal/>
														<ml:id xml:space="preserve">j</ml:id>
														<ml:real>1</ml:real>
													</ml:apply>
													<ml:localDefine>
														<ml:apply>
															<ml:indexer/>
															<ml:id xml:space="preserve">Rbin</ml:id>
															<ml:id xml:space="preserve">j</ml:id>
														</ml:apply>
														<ml:id xml:space="preserve">bit</ml:id>
													</ml:localDefine>
												</ml:ifThen>
											</ml:program>
										</ml:for>
										<ml:localDefine>
											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">Rdec</ml:id>
												<ml:id xml:space="preserve">i</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:id xml:space="preserve">B2D</ml:id>
												<ml:id xml:space="preserve">Rbin</ml:id>
											</ml:apply>
										</ml:localDefine>
									</ml:program>
								</ml:ifThen>
								<ml:localDefine>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">CHIP</ml:id>
										<ml:id xml:space="preserve">i</ml:id>
									</ml:apply>
									<ml:apply>
										<ml:indexer/>
										<ml:id xml:space="preserve">Rbin</ml:id>
										<ml:real>1</ml:real>
									</ml:apply>
								</ml:localDefine>
							</ml:program>
						</ml:for>
						<ml:apply>
							<ml:minus/>
							<ml:apply>
								<ml:mult/>
								<ml:id xml:space="preserve">CHIP</ml:id>
								<ml:real>2</ml:real>
							</ml:apply>
							<ml:real>1</ml:real>
						</ml:apply>
